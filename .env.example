# Database Configuration (Required)
DATABASE_URL=postgresql://username:password@host:port/database

# PostgreSQL credentials (used by pg library)
PGHOST=your-database-host
PGPORT=5432
PGDATABASE=your-database-name
PGUSER=your-username
PGPASSWORD=your-password

# JWT Secret for authentication (Required)
JWT_SECRET=your-secure-jwt-secret-key

# TomTom API Key for location services (Required)
TOMTOM_API_KEY=your-tomtom-api-key

# Session secret
SESSION_SECRET=your-session-secret

# Frontend configuration
EXPO_PUBLIC_API_URL=http://localhost:3001/api

# Legal documents URLs
EXPO_PUBLIC_TERMS_URL=https://your-terms-of-service-url
EXPO_PUBLIC_PRIVACY_URL=https://your-privacy-policy-url
